{
  "id": "dufu",
  "title": "杜甫",
  "subtitle": "“诗圣”",
  "cover": "../../covers/history_dufu.jpg",

  "sections": [
    {
      "title": "人物简介",
      "content": [
        "杜甫（712—770），唐代伟大现实主义诗人。",
        "被誉为“诗圣”，其诗被称为“诗史”。"
      ]
    },
    {
      "title": "主要贡献",
      "content": [
        "以诗记录社会现实。",
        "关怀民生，情感深沉。",
        "推动现实主义诗歌发展。"
      ]
    },
    {
      "title": "文学特点",
      "content": [
        "语言朴实，情感真挚。",
        "结构严谨，思想深刻。",
        "作品具有历史价值。"
      ]
    },
    {
      "title": "代表作品",
      "content": [
        "《春望》",
        "《登高》",
        "《三吏》《三别》"
      ]
    }
  ]
}
