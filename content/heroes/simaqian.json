{
  "id": "simaqian",
  "title": "司马迁",
  "subtitle": "史学家，《史记》作者",
  "cover": "../../covers/history_simaqian.jpg",

  "sections": [
    {
      "title": "人物简介",
      "content": [
        "司马迁（约前145—前86），西汉史学家、文学家。",
        "著有《史记》，是中国第一部纪传体通史。"
      ]
    },
    {
      "title": "主要贡献",
      "content": [
        "创作《史记》，奠定中国史学基础。",
        "采用纪传体写法，影响后世史书结构。",
        "以真实记录历史著称。"
      ]
    },
    {
      "title": "文学特点",
      "content": [
        "语言生动，人物刻画鲜明。",
        "结构严谨，史料丰富。",
        "具有极高文学价值。"
      ]
    },
    {
      "title": "代表作品",
      "content": [
        "《史记》",
        "《报任安书》"
      ]
    }
  ]
}
