{
  "id": "laozi",
  "title": "老子",
  "subtitle": "道家创始人",
  "cover": "../../covers/history_laozi.jpg",

  "sections": [
    {
      "title": "人物简介",
      "content": [
        "老子（约公元前571—前471），道家学派创始人。",
        "著有《道德经》，影响深远。"
      ]
    },
    {
      "title": "主要贡献",
      "content": [
        "提出“道法自然”，强调顺应自然规律。",
        "倡导“无为而治”，反对过度干预。",
        "其思想影响中国哲学两千多年。"
      ]
    },
    {
      "title": "思想特点",
      "content": [
        "崇尚自然与朴素。",
        "强调柔弱胜刚强。",
        "主张清静无为。"
      ]
    },
    {
      "title": "名言名句",
      "content": [
        "“上善若水。”",
        "“大音希声，大象无形。”"
      ]
    }
  ]
}
