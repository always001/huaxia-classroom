{
  "id": "libai",
  "title": "李白",
  "subtitle": "“诗仙”",
  "cover": "../../covers/history_libai.jpg",

  "sections": [
    {
      "title": "人物简介",
      "content": [
        "李白（701—762），唐代伟大浪漫主义诗人。",
        "被誉为“诗仙”，诗风豪放飘逸。"
      ]
    },
    {
      "title": "主要贡献",
      "content": [
        "开创浪漫主义诗歌高峰。",
        "诗歌想象丰富，语言优美。",
        "代表作流传千古。"
      ]
    },
    {
      "title": "文学特点",
      "content": [
        "豪放洒脱，想象奇特。",
        "语言清新自然。",
        "情感真挚奔放。"
      ]
    },
    {
      "title": "代表作品",
      "content": [
        "《将进酒》",
        "《静夜思》",
        "《望庐山瀑布》"
      ]
    }
  ]
}
