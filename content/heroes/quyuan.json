{
  "id": "quyuan",
  "title": "屈原",
  "subtitle": "伟大诗人",
  "cover": "../../covers/history_quyuan.jpg",

  "sections": [
    {
      "title": "人物简介",
      "content": [
        "屈原（约公元前340—前278），战国时期楚国诗人。",
        "代表作《离骚》《九歌》，是中国文学史上的重要人物。"
      ]
    },
    {
      "title": "主要贡献",
      "content": [
        "开创“楚辞”文学形式。",
        "以爱国情怀著称，影响后世诗歌发展。",
        "端午节源于纪念屈原。"
      ]
    },
    {
      "title": "文学特点",
      "content": [
        "语言华丽，情感深沉。",
        "善用比喻与象征。",
        "作品充满爱国精神。"
      ]
    },
    {
      "title": "代表作品",
      "content": [
        "《离骚》",
        "《九歌》",
        "《天问》"
      ]
    }
  ]
}
